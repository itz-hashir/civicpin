# Required for real database-backed API operation.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/incident-app?retryWrites=true&w=majority&authSource=admin
AUTH_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Optional location restriction (server-side). Leave unset to allow any valid coordinates.
# MUNICIPAL_BBOX=-172.0,51.0,-171.0,52.0
# MUNICIPAL_GEOJSON={"type":"Polygon","coordinates":[[[69.2,30.2],[69.5,30.2],[69.5,30.4],[69.2,30.4],[69.2,30.2]]]}

# Android uses the deployed origin, without a trailing slash.
APP_ORIGIN=https://incident-app-chi.vercel.app
