<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Civicpin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorOnSecondary">@color/forest</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/base</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/brick</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/base</item>
        <item name="android:statusBarColor">@color/forest</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/base</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.Civicpin.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.Civicpin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/forest</item>
        <item name="android:textColor">@color/forest</item>
    </style>

    <style name="Widget.Civicpin.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Text.Civicpin.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/forest</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Civicpin.TimelineTitle" parent="TextAppearance.Material3.TitleSmall" />

    <style name="Text.Civicpin.TimelineNote" parent="TextAppearance.Material3.BodyMedium" />

    <style name="Text.Civicpin.Helper" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Civicpin.Error" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/brick</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Civicpin.Status" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
